    {
      "name": "execute_approved_intent",
      "description": "Record the submitted, confirmed, failed, or rejected receipt for a prepared typed-adapter intent. Raw arbitrary calldata is rejected by the lifecycle API. Use this after the signing wallet has broadcast the transaction.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string"
          },
          "agentAddress": {
            "type": "string",
            "pattern": "^0x[a-fA-F0-9]{40}$"
          },
          "sessionToken": {
            "type": "string",
            "minLength": 32,
            "maxLength": 256
          },
          "intentId": {
            "type": "string",
            "pattern": "^fdi\\_"
          },
          "status": {
            "type": "string",
