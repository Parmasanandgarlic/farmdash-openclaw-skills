{
  "name": "FarmDash Autonomous Operator",
  "version": "2.1.2",
  "description": "Use to run supervised autopilot cycles under a bounded, revocable session grant: intents, policy checks, approvals, receipts. Execution stays preview-gated.",
  "tags": [
    "defi",
    "autonomous-defi-agent",
    "ai-agent",
    "defi-automation",
    "openclaw",
    "agent-orchestration",
    "session-key",
    "delegated-execution",
    "ooda-loop",
    "intent-management",
    "risk-controls",
    "circuit-breaker",
    "agent-recovery",
    "zero-custody",
    "mcp",
    "web3",
    "farmdash"
  ],
  "author": "FarmDash Pioneers (@Parmasanandgarlic)",
  "homepage": "https://www.farmdash.one/agents",
  "icon": "operator",
  "tools": [
    {
      "name": "create_session",
      "description": "Creates a persistent agent session and returns a one-time `sessionToken`. Store it securely in the agent runtime. FarmDash stores only a hash.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "agentAddress": {
            "type": "string",
            "pattern": "^0x[a-fA-F0-9]{40}$"
          },
          "agentName": {
            "type": "string"
          },
          "signature": {
            "type": "string",
            "minLength": 1
          },
          "nonce": {
            "type": "string",
            "minLength": 1
          },
          "issuedAt": {
            "type": "string",
            "format": "date-time"
          },
          "signatureType": {
            "type": "string",
            "enum": [
              "eip712",
              "eip191"
            ]
          }
        },
        "required": [
          "agentAddress"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "outputHints": [],
      "category": "write"
    },
    {
      "name": "session_heartbeat",
      "description": "Extends the session expiry. Use it during active autonomous loops. If a session expires, the Operator must enter Crash Recovery mode (see below).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string"
          },
          "agentAddress": {
            "type": "string",
            "pattern": "^0x[a-fA-F0-9]{40}$"
          },
          "sessionToken": {
            "type": "string"
          }
        },
        "required": [
          "sessionId",
          "agentAddress",
          "sessionToken"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "outputHints": [],
      "category": "write"
    },
    {
      "name": "get_farming_context",
      "description": "Reads shared context for the session:\r\n* objective.\r\n* portfolio scope.\r\n* risk settings (including dynamically tuned `riskMultiplier`).\r\n* workflow state (ACTIVE, HALTED, RECOVERING).\r\n* ledger summary.\r\n* data freshness timestamps.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string"
          },
          "agentAddress": {
            "type": "string",
            "pattern": "^0x[a-fA-F0-9]{40}$"
          },
          "sessionToken": {
            "type": "string"
          }
        },
        "required": [
          "sessionId",
          "agentAddress",
          "sessionToken"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "outputHints": [],
      "category": "read"
    },
    {
      "name": "patch_farming_context",
      "description": "Patches shared context. The server controls `sessionId`, `agentAddress`, `revision`, and `updatedAt`; do not try to override them. Used for Dynamic Risk Autotuning and Circuit Breakers.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string"
          },
          "agentAddress": {
            "type": "string",
            "pattern": "^0x[a-fA-F0-9]{40}$"
          },
          "sessionToken": {
            "type": "string"
          },
          "patch": {
            "type": "object",
            "additionalProperties": {}
          }
        },
        "required": [
          "sessionId",
          "agentAddress",
          "sessionToken",
          "patch"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "outputHints": [],
      "category": "write"
    },
    {
      "name": "get_event_stream_snapshot",
      "description": "Reads recent agent events as a JSON snapshot. Use this before planning and after execution.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string"
          },
          "agentAddress": {
            "type": "string",
            "pattern": "^0x[a-fA-F0-9]{40}$"
          },
          "sessionToken": {
            "type": "string"
          },
          "since": {
            "type": "string"
          },
