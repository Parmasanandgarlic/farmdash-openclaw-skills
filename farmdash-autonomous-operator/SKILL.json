    },
    {
      "name": "agent_onboard",
      "description": "One-call setup guide and capability map for autonomous operation. Takes no parameters.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "outputHints": [],
      "category": "read"
    },
    {
      "name": "get_agent_activity",
      "description": "Lists durable FarmDash receipts, optionally filtered by intent and status. Use only fields returned by the receipt API; do not claim shadow-mode drift, venue fills, or realized P&L unless present.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string"
          },
          "agentAddress": {
            "type": "string",
            "pattern": "^0x[a-fA-F0-9]{40}$"
          },
          "sessionToken": {
            "type": "string",
            "minLength": 32,
            "maxLength": 256
          },
          "intentId": {
            "type": "string",
            "pattern": "^fdi\\_"
          },
          "status": {
            "type": "string",
            "enum": [
              "SUBMITTED",
              "CONFIRMED",
              "FAILED",
              "REJECTED"
            ]
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 250
          }
        },
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "outputHints": [],
      "category": "read"
    },
    {
      "name": "resolve_defi_intent",
      "description": "Resolves a high-level natural language DeFi intent into structured parameters for policy/simulation/approval. Supervised execution uses local EIP-191/EIP-712 signing; bounded autonomy requires the separate grant described above. Autonomous Operator never receives private keys.\r\n\r\n**Intent Lifecycle — Plan → Approve → Execute → Observe**\r\nThe FarmDashIntent lifecycle enforces a strict pipeline. Every state-changing action must pass through policy, simulation, and approval gates before execution is allowed. These tools never hold private keys or broadcast transactions directly.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "swap",
              "deposit",
              "stake",
              "provide_liquidity",
              "withdraw",
              "claim"
            ]
          },
          "protocolId": {
            "type": "string"
          },
          "chainId": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0
              },
              {
                "type": "string",
                "const": "solana-mainnet"
              }
            ]
          },
          "toChainId": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0
              },
              {
                "type": "string",
                "const": "solana-mainnet"
              }
            ]
          },
          "tokenIn": {
            "type": "string"
          },
          "amountIn": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "userAddress": {
            "type": "string"
          },
          "tokenOut": {
            "type": "string"
          },
          "amountOut": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "slippage": {
            "type": "number",
            "minimum": 0.01,
            "maximum": 5
          },
          "poolAddress": {
            "type": "string"
          },
          "deadline": {
            "type": "number"
          },
          "constraints": {
            "type": "object",
            "properties": {
              "minAmountOut": {
                "type": "string",
                "pattern": "^[0-9]+$"
              },
              "maxSlippageBps": {
                "type": "integer",
                "exclusiveMinimum": 0
              },
              "maxGasUsd": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "expectedUpsideUsd": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "riskBufferUsd": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "positiveNetEdge": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        },
        "required": [
          "action",
          "protocolId",
          "chainId",
          "tokenIn",
          "amountIn",
          "userAddress"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "outputHints": [],
      "category": "read"
    },
    {
      "name": "create_intent",
      "description": "Create a durable FarmDashIntent. This records what an agent wants to do — it never prepares, signs, broadcasts, or executes. The intent must include actor, action, chain, protocol, wallet, params, constraints, evidence, and `research_evidence_hash` (passed from Trail Intelligence).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string"
          },
          "agentAddress": {
            "type": "string",
            "pattern": "^0x[a-fA-F0-9]{40}$"
          },
          "sessionToken": {
            "type": "string",
            "minLength": 32,
            "maxLength": 256
          },
          "intent": {
            "type": "object",
            "additionalProperties": {},
            "description": "FarmDashIntent create input. Must include actor, action, chain, protocol, wallet, params, constraints, and evidence."
          }
        },
        "required": [
          "intent"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "outputHints": [],
      "category": "write"
    },
    {
      "name": "policy_check_intent",
      "description": "Readiness probe for the generic intent policy gate. Public OpenClaw callers cannot provide trusted policy decisions; until the server policy evaluator is configured this returns policy_evaluator_unconfigured. Tool discovery does not grant policy authority.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string"
          },
          "agentAddress": {
            "type": "string",
            "pattern": "^0x[a-fA-F0-9]{40}$"
          },
          "sessionToken": {
            "type": "string",
            "minLength": 32,
            "maxLength": 256
          },
          "intentId": {
            "type": "string",
            "pattern": "^fdi\\_"
          },
          "policy": {
            "type": "object",
            "additionalProperties": {}
          },
          "context": {
            "$ref": "#/properties/policy"
          }
        },
        "required": [
          "intentId"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "outputHints": [],
      "category": "read"
    },
    {
      "name": "simulate_intent",
      "description": "Readiness probe for the generic intent simulation gate. Public OpenClaw callers cannot record trusted simulation evidence; until a server verifier is configured this returns simulation_verifier_unconfigured. Tool discovery does not grant simulation authority.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string"
          },
          "agentAddress": {
            "type": "string",
            "pattern": "^0x[a-fA-F0-9]{40}$"
          },
          "sessionToken": {
            "type": "string",
            "minLength": 32,
            "maxLength": 256
          },
          "intentId": {
            "type": "string",
            "pattern": "^fdi\\_"
          },
          "simulation": {
            "type": "object",
            "additionalProperties": {}
          }
        },
        "required": [
          "intentId"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "outputHints": [],
      "category": "write"
    },
    {
      "name": "request_approval_payload",
      "description": "Build the EIP-712 IntentApproval payload that the human approver signs. This does not record approval or execute — it only constructs the typed data for the approver's wallet to sign.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string"
          },
          "agentAddress": {
            "type": "string",
            "pattern": "^0x[a-fA-F0-9]{40}$"
          },
          "sessionToken": {
            "type": "string",
