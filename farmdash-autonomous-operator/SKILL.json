        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "outputHints": [],
      "category": "write"
    },
    {
      "name": "autopilot_cycle",
      "description": "Run bounded autonomous cycles. Respect user allowlists, risk limits, and execution confirmations. (Syndicate tier required).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string"
          },
          "agentAddress": {
            "type": "string",
            "pattern": "^0x[a-fA-F0-9]{40}$"
          },
          "sessionToken": {
            "type": "string"
          },
