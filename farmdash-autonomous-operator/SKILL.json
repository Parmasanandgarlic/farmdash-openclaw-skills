            "maxLength": 256
          },
          "intentId": {
            "type": "string",
            "pattern": "^fdi\\_"
          },
          "approverAddress": {
            "type": "string",
            "minLength": 1
          },
          "decision": {
            "type": "string",
            "enum": [
              "APPROVED",
              "REJECTED"
            ],
            "default": "APPROVED"
          },
          "expiresInSeconds": {
            "type": "integer",
