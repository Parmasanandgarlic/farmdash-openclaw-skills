    {
      "name": "hire_virtuals_specialist",
      "description": "Prepare a non-spendable, tenant-owned Virtuals ACP tender and return the exact EIP-712 approval payload. The customer's registered ACP wallet must sign that payload locally. Its local FarmDash ACP connector then creates and funds the three specialist jobs after explicit per-action approval. FarmDash is only the separately registered evaluator: it verifies the client, provider, evaluator, budget cap, deliverables, simulation, and Base receipts before completing or rejecting already customer-funded escrow jobs. Never provide a private key or RPC URL to this tool.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "agentAddress": {
            "type": "string",
            "pattern": "^0x[a-fA-F0-9]{40}$"
          },
          "sessionToken": {
            "type": "string",
            "minLength": 32,
            "maxLength": 256
          },
          "idempotencyKey": {
            "type": "string",
            "minLength": 16,
            "maxLength": 200
          },
          "task": {
            "type": "object",
            "additionalProperties": {},
            "description": "Task payload retained by the local customer connector; FarmDash persists only its commitment hash."
          },
          "simulationId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "expectedOutputAmount": {
            "type": "string",
            "pattern": "^\\d+(?:\\.\\d+)?$"
          },
          "expectedGasUsdCents": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "expectedYieldUsdCents": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "maxPaymentUnits": {
            "type": "string",
            "pattern": "^[0-9]+$",
            "description": "Maximum total raw Base USDC units (6 decimals) across the three customer-funded jobs."
          },
          "providers": {
            "type": "object",
            "properties": {
              "solidity_auditor": {
                "type": "string",
                "pattern": "^0x[a-fA-F0-9]{40}$"
              },
              "defi_economist": {
                "type": "string",
                "pattern": "^0x[a-fA-F0-9]{40}$"
              },
              "sentiment_analyst": {
                "type": "string",
                "pattern": "^0x[a-fA-F0-9]{40}$"
              }
            },
            "required": [
              "solidity_auditor",
              "defi_economist",
              "sentiment_analyst"
            ],
            "additionalProperties": false
          },
          "approvalNonce": {
            "type": "string",
            "pattern": "^\\d{10,20}$"
          },
          "approvalExpiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "sessionId",
          "agentAddress",
          "sessionToken",
          "idempotencyKey",
          "task",
          "simulationId",
          "expectedOutputAmount",
          "expectedGasUsdCents",
          "expectedYieldUsdCents",
          "maxPaymentUnits",
          "providers",
          "approvalNonce",
          "approvalExpiresAt"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "outputHints": [],
      "category": "read"
    },
