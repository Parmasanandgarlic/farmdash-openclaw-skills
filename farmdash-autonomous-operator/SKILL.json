          },
          "apiWalletAddress": {
            "type": "string",
            "pattern": "^0x[a-fA-F0-9]{40}$"
          },
          "ownerAddress": {
            "type": "string",
            "pattern": "^0x[a-fA-F0-9]{40}$"
          }
        },
        "required": [
          "agentAddress",
          "apiWalletAddress",
          "ownerAddress"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "outputHints": [],
      "category": "read"
    },
    {
      "name": "configure_autopilot",
      "description": "Configure bounded autonomous cycles. Respect user allowlists, risk limits, and execution confirmations. (Syndicate tier required for activation).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string"
          },
          "agentAddress": {
            "type": "string",
            "pattern": "^0x[a-fA-F0-9]{40}$"
          },
          "sessionToken": {
            "type": "string"
          },
          "strategies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "assets": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "riskPreference": {
            "type": "string",
            "enum": [
              "conservative",
              "balanced",
              "aggressive"
            ]
          },
          "maxEquityPct": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 0.8
