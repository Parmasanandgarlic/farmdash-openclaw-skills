      "name": "compare_yields",
      "description": "",
      "inputSchema": {
        "type": "object",
        "properties": {
          "chains": {
            "type": "string",
            "description": "optional chain filter."
          },
          "assets": {
            "type": "string",
            "description": "optional symbols such as `USDC`, `ETH`, `SOL`."
          },
          "projects": {
            "type": "string",
            "description": "optional protocol filter."
          },
          "riskPreference": {
            "type": "string",
            "description": "`conservative`, `balanced`, or `aggressive`."
          },
          "minTvlUsd": {
            "type": "string",
            "description": "minimum pool depth."
          },
          "stableOnly": {
            "type": "string",
            "description": "restrict to stablecoin pools."
          },
          "limit": {
            "type": "string",
            "description": "max results."
          }
        }
      },
      "outputHints": [],
