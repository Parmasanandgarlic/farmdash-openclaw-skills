{
  "name": "FarmDash Ledger Keeper",
  "version": "1.1.2",
  "description": "Use for accounting exports from on-chain activity: realized PnL, ledger CSV, history summaries. Derived read-only from public chains; reconcile before filing.",
  "tags": [
    "defi",
    "defi-accounting",
    "crypto-accounting",
    "crypto-tax",
    "cost-basis",
    "defi-bookkeeping",
    "transaction-ledger",
    "portfolio-reconciliation",
    "trade-history",
    "fee-tracking",
    "pnl-tracking",
    "csv-export",
    "tax-records",
    "onchain-accounting",
    "post-trade-analysis",
    "read-only",
    "openclaw",
    "ai-agent",
    "mcp",
    "farmdash"
  ],
  "author": "FarmDash Pioneers (@Parmasanandgarlic)",
  "homepage": "https://www.farmdash.one/agents",
  "icon": "ledger",
  "tools": [
    {
      "name": "ledger_realized_pnl",
      "description": "The tool name is retained for client compatibility. The current response is an activity-and-cost reconciliation and explicitly returns `realizedPnlUsd: null`; it is not realized P&L.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "agentAddress": {
            "type": "string",
            "pattern": "^0x[a-fA-F0-9]{40}$"
          },
          "start": {
            "type": "string"
          },
          "end": {
            "type": "string"
          }
        },
        "required": [
          "agentAddress"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "outputHints": [
        "spot event count.",
        "confirmed spot event count.",
        "spot volume.",
        "recorded execution costs.",
        "futures event count and estimated notional when event records exist.",
        "recent rows for review.",
        "`calculationScope: recorded_activity_and_costs_only` and completeness fields."
      ],
      "category": "read"
    },
    {
      "name": "ledger_tax_export",
      "description": "Exports recorded spot execution rows as CSV with:\r\n\r\n- agent address.\r\n- date.\r\n- protocol.\r\n- from token.\r\n- to token.\r\n- volume.\r\n- recorded cost.\r\n- tx hash.\r\n- chain id.\r\n\r\nFutures activity requires venue fills for tax-lot accounting and is not represented as tax-ready lots by this skill.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "agentAddress": {
            "type": "string",
            "pattern": "^0x[a-fA-F0-9]{40}$"
          },
          "start": {
            "type": "string"
          },
          "end": {
            "type": "string"
          }
        },
        "required": [
          "agentAddress"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "outputHints": [],
      "category": "read"
    }
  ],
  "operatingRules": [],
  "requiredEnv": {
    "FARMDASH_API_KEY": {
      "description": "Bearer token for Pioneer or Syndicate tier.",
      "required": false
    }
  },
  "links": {
    "website": "https://www.farmdash.one/",
    "agentHub": "https://www.farmdash.one/agents",
    "canonicalSkill": "https://www.farmdash.one/openclaw-skills/farmdash-ledger-keeper/SKILL.md",
    "documentation": "https://www.farmdash.one/docs",
    "status": "https://www.farmdash.one/api/v1/agent/status",
    "openApi": "https://www.farmdash.one/agents/openapi.yaml",
    "mcpDiscovery": "https://www.farmdash.one/.well-known/mcp.json",
    "fees": "https://www.farmdash.one/fees",
    "security": "https://www.farmdash.one/security"
  }
}
